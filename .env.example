# Copy to .env on the machine that RUNS the bot (not in this chat).
GMGN_API_KEY=
DISCORD_WEBHOOK_URL=
DISCORD_PAPER_WEBHOOK_URL=
DISCORD_ARC_WEBHOOK_URL=
DISCORD_ARC_PAPER=
DISCORD_ARC_LIVE_WEBHOOK_URL=
DISCORD_XBTSCOUT_WEBHOOK_URL=
# alias: DISCORD_ARC_LIVE=
# Nansen: refresh-wallets only (optional). Do NOT enable for scheduled polls.
NANSEN_API_KEY=
NANSEN_FOR_TRADES=0
# Paper trading (virtual only)
PAPER_BANKROLL_USD=300
LIVE_TRADING=0
ALLOW_GMGN_CLUSTER=0
# optional
CHAIN=robinhood
POLL_SECONDS=60
WINDOW_SECONDS=900
MIN_WALLETS=2
MIN_TRADE_USD=50
COOLDOWN_SECONDS=7200
WATCH_MIN_REALIZED_USD=0
GMGN_LIMIT=100
WATCHLIST_PATH=rh-wallets/wallets.jsonl
STATE_PATH=./state.json
PAPER_LOG_PATH=./paper_log.jsonl
PAPER_BOOK_PATH=./paper_book.jsonl
PAPER_SUMMARY_PATH=./paper_summary.md

# FOMO (leaderboard buys; 125 credits/call, poll ≥25min)
FOMO_API_KEY=
FOMO_ENABLED=1
FOMO_POLL_SECONDS=1500
FOMO_ALERT_LIMIT=80
FOMO_WATCH_PATH=fomo-wallets/wallets_evm.jsonl

WATCH_MIN_WINRATE=0.40
WATCH_MIN_TRADES_FOR_WR=10
LP_LOCK_MIN=0.01
LP_DOMINATE_MAX=0.30

FOMO_HOLDERS=1
FOMO_HOLDERS_INTERVAL=14400

XBTSCOUT_ENABLED=1
XBTSCOUT_SCRAPE_SECONDS=1800
XBTSCOUT_MAX_TOKENS=1

# Arc LIVE (never put PRIVATE_KEY here for Actions; box-only keys)
# Swaps: Uniswap V4 via arc_swap/swap_v4.cjs (not gmgn-cli). Need GMGN_PRIVATE_KEY on box card.
# LIVE_TRADING=1
# LIVE_CHAINS=arc
# LIVE_WALLET_ADDRESS=0x822AFdCc7f1Ec829f4456A3921ff54B4a6dBCfAe
# LIVE_BANKROLL_USD=80
# LIVE_MAX_OPEN=5
# LIVE_MAX_ENTRIES_WEEK=0
# LIVE_MAX_LOSSES_WEEK=0
# LIVE_ONE_PER_CHAIN=0
# LIVE_STATE_PATH=live_state_arc.json
# LIVE_BOOK_PATH=live_book_arc.jsonl
# GMGN_ALLOW_AUTOMATED_TRADES=1

# Notify price-move hard gate (kill flat charts)
REQUIRE_PRICE_MOVE=1
MIN_ABS_PRICE_CHANGE_M5=3
MIN_ABS_PRICE_MOVE_H1=5
WATCH_MIN_REALIZED_HARD=500
DROP_WEAK_WALLETS=1

# xbtscout harvest (pre-post / early buyers only)
XBTSCOUT_PRE_POST_ONLY=1
XBTSCOUT_MIN_BUY_USD=80

# RH onchain → watch merge (off by default; use vet_rh_onchain.py)
RH_ONCHAIN_MERGE_TO_WATCH=0
RH_ONCHAIN_VET_FLOOR=500

# Priority notify (optional second channel; empty = style main with 【優先】)
DISCORD_PRIORITY_WEBHOOK_URL=
PRIORITY_NOTIFY=1
MIN_CLUSTER_PRIORITY=150
PRIORITY_MIN_WALLETS=2
PRIORITY_MIN_AGE_SEC=1800
PRIORITY_MAX_AGE_SEC=172800
PRIORITY_TITLE_PREFIX=【優先】

# Watchlist prune (scripts/prune_watch_wallets.py)
PRUNE_DRY_RUN=1
PRUNE_APPLY=0
PRUNE_MODE=demote
PRUNE_DUST_MAX_BUY_USD=25
PRUNE_KEEP_SCOUT_RANK=4.0
