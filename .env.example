# Copy to .env on the machine that RUNS the bot (not in this chat).
GMGN_API_KEY=
DISCORD_WEBHOOK_URL=
DISCORD_PAPER_WEBHOOK_URL=
DISCORD_ARC_WEBHOOK_URL=
DISCORD_ARC_PAPER=
DISCORD_ARC_LIVE_WEBHOOK_URL=
DISCORD_XBTSCOUT_WEBHOOK_URL=
# alias: DISCORD_ARC_LIVE=
# Nansen: refresh-wallets only (optional). Do NOT enable for scheduled polls.
NANSEN_API_KEY=
NANSEN_FOR_TRADES=0
# Paper trading (virtual only)
PAPER_BANKROLL_USD=300
LIVE_TRADING=0
ALLOW_GMGN_CLUSTER=0
# optional
CHAIN=robinhood
POLL_SECONDS=60
WINDOW_SECONDS=900
MIN_WALLETS=2
MIN_TRADE_USD=50
COOLDOWN_SECONDS=7200
WATCH_MIN_REALIZED_USD=0
GMGN_LIMIT=100
WATCHLIST_PATH=rh-wallets/wallets.jsonl
STATE_PATH=./state.json
PAPER_LOG_PATH=./paper_log.jsonl
PAPER_BOOK_PATH=./paper_book.jsonl
PAPER_SUMMARY_PATH=./paper_summary.md

# Box tick: free onchain primary (scripts/onchain_signal_tick.py via signal_tick.sh)
SIGNAL_SOURCE=onchain
ONCHAIN_POLL_SECONDS=5
# Box notify cards: dex = DexScreener only (no GMGN). GHA may use gmgn/auto.
NOTIFY_MARKET_SOURCE=dex
# On Dex CF/429 from box: dispatch GHA enrich-notify.yml (never post empty — cards)
ENRICH_ON_DEX_FAIL=1
GMGN_MARKET=0
# Onchain CA cooldown (seconds). Default 300; raise to 900 to reduce noise.
COOLDOWN_SECONDS=300
# FOMO optional interval when SIGNAL_SOURCE=fomo|both. ≥120s when credits scarce.
SIGNAL_POLL_SECONDS=300
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# FOMO (leaderboard buys; 125 credits/call, poll ≥25min on GHA; box matches SIGNAL_POLL)
FOMO_API_KEY=
FOMO_ENABLED=1
FOMO_POLL_SECONDS=1500
FOMO_ALERT_LIMIT=80
FOMO_WATCH_PATH=fomo-wallets/wallets_evm.jsonl

WATCH_MIN_WINRATE=0.40
WATCH_MIN_TRADES_FOR_WR=10
LP_LOCK_MIN=0.01
LP_DOMINATE_MAX=0.30

FOMO_HOLDERS=1
FOMO_HOLDERS_INTERVAL=14400

XBTSCOUT_ENABLED=1
XBTSCOUT_SCRAPE_SECONDS=1800
XBTSCOUT_MAX_TOKENS=1

# Arc LIVE (never put PRIVATE_KEY here for Actions; box-only keys)
# Swaps: Uniswap V4 via arc_swap/swap_v4.cjs (not gmgn-cli). Need GMGN_PRIVATE_KEY on box card.
# LIVE_TRADING=1
# LIVE_CHAINS=arc
# LIVE_WALLET_ADDRESS=0x822AFdCc7f1Ec829f4456A3921ff54B4a6dBCfAe
# LIVE_BANKROLL_USD=80
# LIVE_MAX_OPEN=5
# LIVE_MAX_ENTRIES_WEEK=0
# LIVE_MAX_LOSSES_WEEK=0
# LIVE_ONE_PER_CHAIN=0
# LIVE_STATE_PATH=live_state_arc.json
# LIVE_BOOK_PATH=live_book_arc.jsonl
# GMGN_ALLOW_AUTOMATED_TRADES=1

# Notify price-move hard gate (kill flat charts)
REQUIRE_PRICE_MOVE=1
MIN_ABS_PRICE_CHANGE_M5=3
MIN_ABS_PRICE_MOVE_H1=5
WATCH_MIN_REALIZED_HARD=500
DROP_WEAK_WALLETS=1

# xbtscout harvest (pre-post / early buyers only)
XBTSCOUT_PRE_POST_ONLY=1
XBTSCOUT_MIN_BUY_USD=80

# RH onchain → watch merge (off by default; use vet_rh_onchain.py)
RH_ONCHAIN_MERGE_TO_WATCH=0
RH_ONCHAIN_VET_FLOOR=500

# Priority notify (optional second channel; empty = style main with 【優先】)
DISCORD_PRIORITY_WEBHOOK_URL=
PRIORITY_NOTIFY=1
MIN_CLUSTER_PRIORITY=150
PRIORITY_MIN_WALLETS=3
PRIORITY_MIN_AGE_SEC=1800
PRIORITY_MAX_AGE_SEC=172800
PRIORITY_TITLE_PREFIX=【優先】

# Watchlist prune (scripts/prune_watch_wallets.py)
PRUNE_DRY_RUN=1
PRUNE_APPLY=0
PRUNE_MODE=demote
PRUNE_DUST_MAX_BUY_USD=25
PRUNE_KEEP_SCOUT_RANK=4.0

# GMGN portfolio vet period (GHA gmgn-vet-throttle / batch_vet)
# 30d = default (writes win_rate / realized_pnl_usd / n_trades)
# 7d  = short window (writes win_rate_7d / realized_pnl_7d / n_trades_7d; does not wipe 30d)
# GMGN_PORTFOLIO_PERIOD=30d

# Unknown-trend promote into wallets.jsonl (scripts/promote_unknown_smart.py)
# PROMOTE_MIN_SCORE=40
# PROMOTE_MIN_CAS=2
# PROMOTE_MIN_BUYS=2
# PROMOTE_MIN_VOL_USD=10
# PROMOTE_ACTIVE_HOURS=72
# PROMOTE_MAX_PER_CYCLE=40
# PROMOTE_MAX_CAS=10
# PROMOTE_POOL_EXTRA=30
# PROMOTE_RPC_CHECK=0
# PROMOTE_DRY_RUN=0

# HARD notify gates (NOTIFY_PASSTHROUGH cannot override these)
# Honeypot: GoPlus is_honeypot / high tax for RH (goplus_id=4663); cached.
# If GoPlus unavailable: heuristics (Dex scam labels, buys_m5>>0 sells, tax fields).
HARD_MARKET_GATES=1
HONEYPOT_REQUIRE=1
HONEYPOT_TAX_MAX=0.10
HONEYPOT_ZERO_SELL_BUYS=10
GOPLUS_CACHE_TTL_SEC=3600
# Min volume hard floors ("ある程度出来高"). Soft VOLUME_REQUIRED may stay 0 under RH soft.
HARD_MIN_VOLUME_H24_USD=5000
HARD_MIN_VOLUME_M5_USD=500
# Soft reference floors (used when VOLUME_REQUIRED=1 / non-passthrough)
MIN_VOLUME_H24_USD=8000
MIN_VOLUME_M5_USD=800

# StonkFun Solana digger hunt (scripts/hunt_stonkfun_diggers.py)
# SOLANA_RPC_URL=https://solana-rpc.publicnode.com
# STONKFUN_EVERY_SEC=1800
# STONK_PEAK_MIN_USD=40000
# STONK_TOKEN_CAP=18
# STONK_FIRST_N=30
# STONK_MIN_HITS=2

# StonkFun digger Discord signals (scripts/stonkfun_signal_tick.py)
# Dedicated channel ONLY — never falls back to DISCORD_WEBHOOK_URL (RH).
DISCORD_STONKFUN_WEBHOOK_URL=
# STONKFUN_POLL_SECONDS=20
# STONKFUN_MIN_DIGGERS=1
# STONKFUN_SIG_LIMIT=12
# STONKFUN_COOLDOWN_SECONDS=600
# STONKFUN_SIGNAL_TEST=0
# STONKFUN_TICK_ONCE=0

# Solana smart-wallet Discord signals (scripts/sol_smart_signal_tick.py)
# Dedicated channel ONLY — never falls back to DISCORD_WEBHOOK_URL or DISCORD_STONKFUN_WEBHOOK_URL.
DISCORD_SOL_SMART_WEBHOOK_URL=
# Paper 実況 ONLY (never post balance spam to signal channels)
DISCORD_SOL_PAPER_WEBHOOK_URL=
# SOL_SMART_POLL_SECONDS=30
# SOL_SMART_MIN_WALLETS=1
# SOL_SMART_SIG_LIMIT=8
# SOL_SMART_COOLDOWN_SECONDS=600
# SOL_SMART_SIGNAL_TEST=0
# SOL_SMART_TICK_ONCE=0

# --- Solana paper trading (per notify channel, $100 each) ---
# LIVE_TRADING must stay 0. Daemon: scripts/sol_paper_tick.sh
SOL_PAPER_TICK_SEC=90
SOL_PAPER_BANKROLL_USD=100
SOL_PAPER_MAX_OPEN=4
SOL_PAPER_DISCORD=1
SOL_PAPER_JIKEI_SEC=1200
SOL_PAPER_SEED_ON_START=1
PAPER_MARK_HEARTBEAT=0

# Sol paper aggressive moonbag (sol_paper_tick setdefaults if unset)
# PAPER_SIZE_PCT_DEFAULT=30
# PAPER_SIZE_PCT_STRONG=40
