NANSEN_API_KEY=
NANSEN_FOR_TRADES=0
# optional
CHAIN=robinhood
POLL_SECONDS=60
WINDOW_SECONDS=900
MIN_WALLETS=2
MIN_TRADE_USD=50
COOLDOWN_SECONDS=21600
WATCH_MIN_REALIZED_USD=0
GMGN_LIMIT=100
WATCHLIST_PATH=rh-wallets/wallets.jsonl
STATE_PATH=./state.json
PAPER_LOG_PATH=./paper_log.jsonl
